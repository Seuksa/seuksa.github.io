---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProvinceChart from '../../../components/stats/ProvinceChart.vue';
import HonourSearch from '../../../components/stats/HonourSearch.vue';
import { PROVINCES, provinceByKey } from '../../../data/provinces';
import { ALL_HONOUREES, OUTSTANDING, SUBJECTS, countBy, honoureeId, schoolKey } from '../../../data/outstanding';

const nf = new Intl.NumberFormat('en-US');
const total = ALL_HONOUREES.length;
const years = OUTSTANDING.map((y) => y.year);
const firsts = ALL_HONOUREES.filter((e) => e.rank === 1).length;
const girls = ALL_HONOUREES.filter((e) => e.gender === 'F').length;
const withGender = ALL_HONOUREES.filter((e) => e.gender).length;

const byProvince = countBy(ALL_HONOUREES, (e) => e.province);
const bySchool = countBy(ALL_HONOUREES.filter((e) => e.school), schoolKey).slice(0, 15);
const perYear = OUTSTANDING.map((y) => ({ year: y.year, n: y.entries.length, verified: y.verified, ranks: y.ranksPerSubject }));

const rows = ALL_HONOUREES.map((e) => ({
  year: e.year,
  grade: e.grade,
  subject: e.subject,
  subjectKm: SUBJECTS[e.subject].km,
  rank: e.rank,
  name: e.name,
  gender: e.gender,
  school: e.school,
  province: e.province,
  provinceKm: provinceByKey[e.province].km,
  url: `/stats/outstanding-students/${e.year}/#${honoureeId(e)}`,
})).sort((a, b) => b.year - a.year || b.grade - a.grade || a.subject.localeCompare(b.subject) || a.rank - b.rank);
const provinceOptions = PROVINCES.map((p) => ({ key: p.key, label: `${p.km} · ${p.en}` }));
---

<BaseLayout
  title="National Outstanding Students · សិស្សពូកែទូទាំងប្រទេស"
  description="Honour roll of Cambodia's national outstanding students in Khmer literature, mathematics and physics (grades 9 and 12), from official MoEYS results."
>
  <PageHero
    title="National Outstanding Students"
    kicker="ជ័យលាភីសិស្សពូកែទូទាំងប្រទេស · Honour roll"
    icon="pi pi-trophy"
    description="Khmer literature, mathematics and physics – grades 9 and 12. Every name comes from the Ministry of Education’s official results."
  >
    <div class="mt-6"><Breadcrumbs items={[{ label: 'Statistics', href: '/stats/' }, { label: 'Outstanding students' }]} /></div>
  </PageHero>

  <div class="mx-auto max-w-6xl px-4 py-10">
    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Summary">
      <div class="rounded-2xl border border-surface-200 p-5 dark:border-surface-800">
        <p class="text-sm text-surface-500">Honourees recorded</p>
        <p class="mt-1 text-3xl font-bold tabular-nums">{nf.format(total)}</p>
        <p class="mt-1 text-xs text-surface-500">
          {years.length} year{years.length === 1 ? '' : 's'}:
          {[...years].reverse().map((y, i) => (
            <>{i > 0 && ', '}<a href={`/stats/outstanding-students/?year=${y}#s-search`} class="text-primary-700 hover:underline dark:text-primary-300">{y}</a></>
          ))}
        </p>
      </div>
      <div class="rounded-2xl border border-surface-200 p-5 dark:border-surface-800">
        <p class="text-sm text-surface-500">Rank 1 · <span lang="km">លេខ១</span></p>
        <p class="mt-1 text-3xl font-bold tabular-nums">{firsts}</p>
        <p class="mt-1 text-xs text-surface-500">3 subjects × 2 grades each year</p>
      </div>
      <div class="rounded-2xl border border-surface-200 p-5 dark:border-surface-800">
        <p class="text-sm text-surface-500">Girls</p>
        <p class="mt-1 text-3xl font-bold tabular-nums">{withGender ? Math.round((girls / withGender) * 100) : 0}%</p>
        <p class="mt-1 text-xs text-surface-500">{girls} of {withGender} with published gender</p>
      </div>
      <div class="rounded-2xl border border-surface-200 p-5 dark:border-surface-800">
        <p class="text-sm text-surface-500">Provinces represented</p>
        <p class="mt-1 text-3xl font-bold tabular-nums">{byProvince.length}<span class="text-lg font-normal text-surface-400"> / 25</span></p>
        <p class="mt-1 text-xs text-surface-500">Top: {provinceByKey[byProvince[0][0]].en} ({byProvince[0][1]})</p>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="s-search">
      <h2 id="s-search" class="scroll-mt-20 text-xl font-bold">Honour roll · តារាងកិត្តិយស</h2>
      <p class="mb-4 text-sm text-surface-500">Search any honouree by name or school, or filter by province, grade and subject.</p>
      <HonourSearch client:load rows={rows} provinces={provinceOptions} />
    </section>

    <section class="mt-14" aria-labelledby="s-prov">
      <h2 id="s-prov" class="text-xl font-bold">Honourees by capital / province</h2>
      <p class="mb-3 text-sm text-surface-500">All recorded years combined, shown with short codes (key below). Hover a bar for details; <strong>click a bar</strong> to see that province’s honourees year by year.</p>
      <div class="rounded-2xl border border-surface-200 p-4 dark:border-surface-800">
        <ProvinceChart
          client:visible
          rows={ALL_HONOUREES.map((e) => ({ province: e.province, grade: e.grade, rank: e.rank, subject: e.subject }))}
          provinces={PROVINCES.map((p) => ({ key: p.key, km: p.km, en: p.en, shortKm: p.shortKm, code: p.code }))}
          subjects={Object.fromEntries(Object.entries(SUBJECTS).map(([k, v]) => [k, v.en]))}
        />
      </div>
      <dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1 text-xs text-surface-600 sm:grid-cols-3 lg:grid-cols-5 dark:text-surface-400" aria-label="Province codes">
        {
          byProvince.map(([k]) => (
            <div class="flex gap-2">
              <dt class="w-16 shrink-0 font-semibold text-surface-800 dark:text-surface-200"><span lang="km">{provinceByKey[k].shortKm}</span> {provinceByKey[k].code}</dt>
              <dd class="truncate"><span lang="km">{provinceByKey[k].km}</span></dd>
            </div>
          ))
        }
      </dl>
    </section>

    <div class="mt-14 grid gap-10 lg:grid-cols-2">
      <section aria-labelledby="s-school">
        <h2 id="s-school" class="text-xl font-bold">Schools with the most honourees</h2>
        <ol class="mt-4 divide-y divide-surface-100 rounded-2xl border border-surface-200 dark:divide-surface-800 dark:border-surface-800" lang="km">
          {
            bySchool.map(([k, n], i) => {
              const [prov, school] = k.split('|');
              return (
                <li class="flex items-center gap-3 px-4 py-2.5 text-sm">
                  <span class="w-6 text-right text-surface-400 tabular-nums">{i + 1}</span>
                  <span class="flex-1">
                    <a href={`/stats/outstanding-students/?q=${encodeURIComponent(school)}`} class="font-medium hover:text-primary-700 dark:hover:text-primary-300">{school}</a>
                    <span class="block text-xs text-surface-500">{provinceByKey[prov].km}</span>
                  </span>
                  <span class="font-semibold tabular-nums">{n}</span>
                </li>
              );
            })
          }
        </ol>
      </section>
      <section aria-labelledby="s-years">
        <h2 id="s-years" class="text-xl font-bold">Years in the archive</h2>
        <ul class="mt-4 space-y-2">
          {
            perYear.reverse().map((y) => (
              <li>
                <a href={`/stats/outstanding-students/${y.year}/`} class="flex items-center justify-between rounded-xl border border-surface-200 px-4 py-3 hover:border-primary-300 dark:border-surface-800">
                  <span class="font-semibold">{y.year}</span>
                  <span class="text-sm text-surface-500">
                    {y.n} honourees · top {y.ranks} per subject
                    {!y.verified && <span class="ml-2 rounded bg-amber-100 px-1.5 py-0.5 text-[11px] text-amber-900 dark:bg-amber-900/40 dark:text-amber-200">transcribed – being verified</span>}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 rounded-2xl bg-surface-50 p-5 text-sm text-surface-600 dark:bg-surface-900 dark:text-surface-400">
          <h3 class="font-semibold text-surface-800 dark:text-surface-200">About this honour roll</h3>
          <p class="mt-2">
            The national exam has been held every year since 1986, after provincial selection rounds. Names, schools and provinces are copied
            from the Ministry’s official results; we do not publish dates of birth or any other personal details. Spot a mistake, or have an
            official list for a missing year? <a href="/about/" class="text-primary-700 hover:underline dark:text-primary-300">Tell us</a>.
          </p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
