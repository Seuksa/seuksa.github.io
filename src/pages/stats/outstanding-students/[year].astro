---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { provinceByKey } from '../../../data/provinces';
import { COMPETITIONS } from '../../../data/olympiads';
import { olympiadsByHonouree } from '../../../data/olympiads/honour-links';
import { GRADES, OUTSTANDING, SUBJECTS, SUBJECT_ORDER, countBy, honoureeId, type OutstandingYear } from '../../../data/outstanding';

export function getStaticPaths() {
  return OUTSTANDING.map((y, i) => ({
    params: { year: String(y.year) },
    props: { y, prev: OUTSTANDING[i - 1]?.year, next: OUTSTANDING[i + 1]?.year },
  }));
}

const { y, prev, next } = Astro.props as { y: OutstandingYear; prev?: number; next?: number };
const olympians = olympiadsByHonouree(COMPETITIONS.flatMap((c) => c.countries.KHM.contestants.map((p) => ({ ...p, competition: c.competition }))));
const AWARD: Record<string, string> = { G: 'gold', S: 'silver', B: 'bronze', HM: 'honourable mention' };
const byProvince = countBy(y.entries, (e) => e.province);
const max = byProvince[0]?.[1] ?? 1;
const girls = y.entries.filter((e) => e.gender === 'F').length;
const medal = (rank: number) =>
  rank === 1 ? 'bg-amber-400 text-amber-950' : rank === 2 ? 'bg-slate-300 text-slate-900' : rank === 3 ? 'bg-orange-300 text-orange-950' : 'bg-surface-100 text-surface-700 dark:bg-surface-800 dark:text-surface-200';
---

<BaseLayout
  title={`Outstanding students ${y.year} · សិស្សពូកែទូទាំងប្រទេស ${y.year}`}
  description={`National outstanding students ${y.year} – Khmer literature, mathematics and physics, grades 9 and 12: ${y.entries.length} honourees by name, school and province.`}
  type="article"
>
  <PageHero
    title={`Outstanding students ${y.year}`}
    kicker={`ជ័យលាភីសិស្សពូកែទូទាំងប្រទេស ឆ្នាំ${y.year}`}
    icon="pi pi-trophy"
    description={`${y.entries.length} honourees · top ${y.ranksPerSubject} per subject · ${byProvince.length} provinces · ${girls} girls`}
  >
    <div class="mt-6"><Breadcrumbs items={[{ label: 'Statistics', href: '/stats/' }, { label: 'Outstanding students', href: '/stats/outstanding-students/' }, { label: String(y.year) }]} /></div>
  </PageHero>

  <div class="mx-auto max-w-6xl px-4 py-10">
    {
      !y.verified && (
        <p class="mb-8 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-200">
          <i class="pi pi-info-circle mr-2" />
          Names were transcribed from the official {y.transcribedFrom === 'image' ? 'images' : 'list'} and are awaiting a final check. Please compare with the source below and tell us if anything is wrong.
        </p>
      )
    }

    <dl class="grid gap-4 text-sm sm:grid-cols-3">
      {y.examDate && <div><dt class="text-surface-500">Exam</dt><dd class="font-medium">{y.examDate}</dd></div>}
      {y.resultsDate && <div><dt class="text-surface-500">Results announced</dt><dd class="font-medium">{y.resultsDate}</dd></div>}
      {y.host && <div><dt class="text-surface-500">Held at</dt><dd class="font-medium">{y.host}</dd></div>}
    </dl>

    {
      GRADES.map((g) => (
        <section class="mt-12" aria-labelledby={`g${g}`}>
          <h2 id={`g${g}`} class="text-2xl font-bold">Grade {g} <span class="font-normal text-surface-400" lang="km">· ថ្នាក់ទី{g}</span></h2>
          <div class="mt-5 grid gap-6 lg:grid-cols-3">
            {SUBJECT_ORDER.map((s) => {
              const list = y.entries.filter((e) => e.grade === g && e.subject === s).sort((a, b) => a.rank - b.rank);
              return (
                <div class="rounded-2xl border border-surface-200 dark:border-surface-800">
                  <h3 class="border-b border-surface-200 px-4 py-3 font-semibold dark:border-surface-800">
                    {SUBJECTS[s].en} <span class="font-normal text-surface-500" lang="km">· {SUBJECTS[s].km}</span>
                  </h3>
                  {list.length ? (
                    <ol class="divide-y divide-surface-100 dark:divide-surface-800" lang="km">
                      {list.map((e) => (
                        <li id={honoureeId(e)} class="flex gap-3 px-4 py-2.5 target:bg-primary-50 dark:target:bg-primary-950/50">
                          <span class:list={['mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-full text-xs font-bold', medal(e.rank)]}>{e.rank}</span>
                          <span class="min-w-0">
                            <span class="block font-medium">{e.name}</span>
                            {olympians.get(`${y.year}|${honoureeId(e)}`)?.map((o) => (
                              <a
                                href={`/stats/olympiads/?year=${o.year}#cambodia`}
                                lang="en"
                                class="mr-1 mt-0.5 inline-flex items-center gap-1 rounded border border-primary-200 bg-primary-50 px-1.5 py-0.5 text-[11px] text-primary-800 hover:border-primary-400 dark:border-primary-800 dark:bg-primary-950/50 dark:text-primary-200"
                                title={`Represented Cambodia at the ${o.competition} ${o.year}${o.award ? ` – ${AWARD[o.award]}` : ''}${o.possible ? ' (possible match, spellings differ)' : ''}`}
                              >
                                <i class="pi pi-globe text-[10px]" aria-hidden="true" />{o.competition} {o.year}{o.award && ` · ${o.award}`}{o.possible && ' ?'}
                              </a>
                            ))}
                            <span class="block text-xs text-surface-500">{e.school ? `${e.school} · ` : ""}{provinceByKey[e.province].km}</span>
                          </span>
                        </li>
                      ))}
                    </ol>
                  ) : (
                    <p class="px-4 py-6 text-sm text-surface-500">Not published in the sources we found.</p>
                  )}
                </div>
              );
            })}
          </div>
        </section>
      ))
    }

    <section class="mt-14" aria-labelledby="by-prov">
      <h2 id="by-prov" class="text-xl font-bold">By capital / province</h2>
      <ul class="mt-4 space-y-2" lang="km">
        {
          byProvince.map(([k, n]) => (
            <li class="grid grid-cols-[9rem_1fr_2rem] items-center gap-3 text-sm">
              <a href={`/stats/outstanding-students/?province=${k}`} class="truncate hover:text-primary-700 dark:hover:text-primary-300">{provinceByKey[k].km}</a>
              <span class="h-3 rounded-r bg-primary-500" style={`width:${(n / max) * 100}%`} aria-hidden="true" />
              <span class="text-right font-semibold tabular-nums">{n}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-14 grid gap-8 lg:grid-cols-2">
      <div>
        <h2 class="text-xl font-bold">Source</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {
            y.sources.map((s) => (
              <li>
                {s.url ? <a href={s.url} rel="noopener" class="font-medium text-primary-700 hover:underline dark:text-primary-300">{s.title}</a> : <span class="font-medium">{s.title}</span>}
                <span class="block text-surface-500">{s.publisher} · {s.date}{s.archive && <> · <a href={s.archive} class="text-primary-700 hover:underline dark:text-primary-300">archived copy</a></>}</span>
              </li>
            ))
          }
        </ul>
      </div>
      {y.note && <div><h2 class="text-xl font-bold">Notes</h2><p class="mt-3 text-sm text-surface-600 dark:text-surface-400">{y.note}</p></div>}
    </section>

    <nav class="mt-14 flex justify-between gap-4 border-t border-surface-200 pt-6 text-sm dark:border-surface-800" aria-label="Other years">
      {prev ? <a href={`/stats/outstanding-students/${prev}/`} class="text-primary-700 hover:underline dark:text-primary-300">← {prev}</a> : <span />}
      <a href="/stats/outstanding-students/" class="text-surface-500 hover:underline">All years</a>
      {next ? <a href={`/stats/outstanding-students/${next}/`} class="text-primary-700 hover:underline dark:text-primary-300">{next} →</a> : <span />}
    </nav>
  </div>
</BaseLayout>
