---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BarChart from '../../components/stats/BarChart.vue';
import GradeMixChart from '../../components/stats/GradeMixChart.vue';
import { BAC_II, GRADE_KEYS, SOURCES, candidates, hasFullGrades, type BacIIYear } from '../../data/bac-ii';

const nf = new Intl.NumberFormat('en-US');
const n = (v: number | null | undefined) => (v == null ? '—' : nf.format(v));
const pct = (v: number | null | undefined) => (v == null ? '—' : `${v.toFixed(2).replace(/\.00$/, '')}%`);

const years = BAC_II;
const first = years[0];
const latest = years.at(-1)!;
const prev = years.filter((y) => y.passRate != null).at(-2)!;
const held = years.filter((y) => !y.cancelled);
const known = (f: (y: BacIIYear) => number | null) => years.map(f).filter((v): v is number => v != null);
const totalPassed = known((y) => y.passed).reduce((a, b) => a + b, 0);
const best = held.reduce((a, b) => ((b.passRate ?? 0) > (a.passRate ?? 0) ? b : a));
const worst = held.reduce((a, b) => ((b.passRate ?? 100) < (a.passRate ?? 100) ? b : a));
const bestA = years.filter((y) => y.grades?.A != null).reduce((a, b) => (b.grades!.A! > a.grades!.A! ? b : a));

// stable numbering of sources in order of first use
const sourceIds = [...new Set(years.flatMap((y) => y.sources))];
/** Years a source supports, with consecutive years collapsed: "1980–2012, 2014". */
const usedFor = (id: string) => {
  const ys = years.filter((y) => y.sources.includes(id as keyof typeof SOURCES)).map((y) => y.year);
  const out: string[] = [];
  for (let i = 0; i < ys.length; ) {
    let j = i;
    while (j + 1 < ys.length && ys[j + 1] === ys[j] + 1) j++;
    out.push(j - i >= 2 ? `${ys[i]}–${ys[j]}` : ys.slice(i, j + 1).join(', '));
    i = j + 1;
  }
  return out.join(', ');
};
const sourceNo = (id: string) => sourceIds.indexOf(id as keyof typeof SOURCES) + 1;

const details = (y: BacIIYear): [string, string][] =>
  [
    ['Academic year', y.academicYear],
    y.sat != null ? ['Sat the exam', n(y.sat)] : y.registered != null ? ['Registered', n(y.registered)] : null,
    ['Passed', y.cancelled ? 'all (no exam)' : `${y.approx?.includes('passed') ? '≈ ' : ''}${n(y.passed)}`],
    ['Pass rate', y.cancelled ? '—' : pct(y.passRate)],
    y.grades?.A != null ? ['Grade A', n(y.grades.A)] : null,
  ].filter((d): d is [string, string] => !!d);

const passRateItems = years.map((y) => ({
  label: String(y.year),
  value: y.passRate,
  emptyText: y.cancelled ? 'No exam – all passed (COVID-19)' : undefined,
  details: details(y),
}));
const candidateItems = years.map((y) => ({
  label: String(y.year),
  value: candidates(y),
  details: [
    [y.sat != null ? 'Sat the exam' : 'Registered', n(candidates(y))] as [string, string],
    ...details(y).filter(([k]) => !['Sat the exam', 'Registered'].includes(k)),
  ],
}));
const gradeAYears = years.filter((y) => y.year >= 2011);
const gradeAItems = gradeAYears.map((y) => ({
  label: String(y.year),
  value: y.grades?.A ?? null,
  emptyText: y.cancelled ? 'No exam' : 'Not published',
  details: details(y),
}));
const mixRows = years
  .filter(hasFullGrades)
  .map((y) => ({ year: y.year, grades: y.grades as Record<(typeof GRADE_KEYS)[number], number> }));
const updated = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title={`Bac II statistics ${first.year}–${latest.year} · ស្ថិតិបាក់ឌុប`}
  description={`Official results of Cambodia’s grade 12 national exam (Bac II) from ${first.year} to ${latest.year}: candidates, pass rate and grades, with sources for every figure.`}
>
  <PageHero
    title="Bac II exam statistics"
    kicker="ស្ថិតិប្រឡងបាក់ឌុប · Cambodia grade 12 national exam"
    icon="pi pi-chart-bar"
    description={`Every official result we can trace, ${first.year}–${latest.year}: candidates, passes, pass rate and grades. Each figure links to its source.`}
  >
    <div class="mt-6"><Breadcrumbs items={[{ label: 'Statistics', href: '/stats/' }, { label: 'Bac II' }]} /></div>
  </PageHero>

  <div class="mx-auto max-w-6xl px-4 py-10">
    <!-- KPIs -->
    <section aria-labelledby="kpi" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <h2 id="kpi" class="sr-only">Latest results</h2>
      <div class="rounded-2xl border border-surface-200 p-5 dark:border-surface-800">
        <p class="text-sm text-surface-500">Pass rate {latest.year}</p>
        <p class="mt-1 text-3xl font-bold text-surface-900 tabular-nums dark:text-surface-0">{pct(latest.passRate)}</p>
        <p class="mt-1 text-xs text-surface-500">
          {(latest.passRate ?? 0) >= (prev.passRate ?? 0) ? '▲' : '▼'}
          {Math.abs((latest.passRate ?? 0) - (prev.passRate ?? 0)).toFixed(2)} pts vs {prev.year} ({pct(prev.passRate)})
        </p>
      </div>
      <div class="rounded-2xl border border-surface-200 p-5 dark:border-surface-800">
        <p class="text-sm text-surface-500">Passed {latest.year}</p>
        <p class="mt-1 text-3xl font-bold text-surface-900 tabular-nums dark:text-surface-0">{n(latest.passed)}</p>
        <p class="mt-1 text-xs text-surface-500">of {n(candidates(latest))} {latest.sat != null ? 'who sat' : 'registered'}</p>
      </div>
      <div class="rounded-2xl border border-surface-200 p-5 dark:border-surface-800">
        <p class="text-sm text-surface-500">Grade A {latest.year}</p>
        <p class="mt-1 text-3xl font-bold text-surface-900 tabular-nums dark:text-surface-0">{n(latest.grades?.A)}</p>
        <p class="mt-1 text-xs text-surface-500">Record: {n(bestA.grades?.A)} in {bestA.year}</p>
      </div>
      <div class="rounded-2xl border border-surface-200 p-5 dark:border-surface-800">
        <p class="text-sm text-surface-500">Total passed, {first.year}–{latest.year}</p>
        <p class="mt-1 text-3xl font-bold text-surface-900 tabular-nums dark:text-surface-0">{(totalPassed / 1e6).toFixed(2)} million</p>
        <p class="mt-1 text-xs text-surface-500">{held.length} exams held · counts only years whose pass totals were published</p>
      </div>
    </section>

    <!-- Pass rate -->
    <section class="mt-12" aria-labelledby="c-rate">
      <div class="mb-3 flex flex-wrap items-end justify-between gap-2">
        <div>
          <h2 id="c-rate" class="text-xl font-bold">Pass rate by year</h2>
          <p class="text-sm text-surface-500">
            Highest {pct(best.passRate)} ({best.year}) · lowest {pct(worst.passRate)} ({worst.year}) · × = no exam
          </p>
        </div>
      </div>
      <div class="rounded-2xl border border-surface-200 p-4 dark:border-surface-800">
        <BarChart
          client:visible
          title="Bac II pass rate by year"
          unit="pct"
          valueLabel="Pass rate"
          max={100}
          tickEvery={5}
          items={passRateItems}
          labelled={[String(best.year), String(latest.year)]}
          annotations={[['2014', '2014 reform']]}
        />
      </div>
    </section>

    <!-- Candidates -->
    <section class="mt-12" aria-labelledby="c-cand">
      <h2 id="c-cand" class="text-xl font-bold">Candidates by year</h2>
      <p class="mb-3 text-sm text-surface-500">
        Candidates who sat the exam, or registered candidates when only registrations were published (see table). Gaps = not published.
      </p>
      <div class="rounded-2xl border border-surface-200 p-4 dark:border-surface-800">
        <BarChart client:visible title="Bac II candidates by year" valueLabel="Candidates" tickEvery={5} items={candidateItems} labelled={[String(first.year), String(latest.year)]} />
      </div>
    </section>

    <div class="mt-12 grid gap-12">
      <!-- Grade A -->
      <section aria-labelledby="c-a">
        <h2 id="c-a" class="text-xl font-bold">Grade A students</h2>
        <p class="mb-3 text-sm text-surface-500">Since {gradeAYears[0].year}, when counts were first reported. Gaps = not published.</p>
        <div class="rounded-2xl border border-surface-200 p-4 dark:border-surface-800">
          <BarChart client:visible title="Grade A students by year" valueLabel="Grade A" tickEvery={3} items={gradeAItems} labelled={['2014', String(bestA.year), String(latest.year)]} />
        </div>
      </section>
      <!-- Grade mix -->
      <section aria-labelledby="c-mix">
        <h2 id="c-mix" class="text-xl font-bold">Grade mix of those who passed</h2>
        <p class="mb-3 text-sm text-surface-500">Years with a complete official A–E breakdown.</p>
        <div class="rounded-2xl border border-surface-200 p-5 dark:border-surface-800">
          <GradeMixChart client:visible rows={mixRows} />
        </div>
      </section>
    </div>

    <!-- Table -->
    <section class="mt-14" aria-labelledby="t-all">
      <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 id="t-all" class="text-xl font-bold">All results · លទ្ធផលទាំងអស់</h2>
          <p class="text-sm text-surface-500">— = not published in any official source we found. ≈ = reported as approximate. Pass rates are on candidates who sat.</p>
        </div>
        <div class="flex gap-2">
          <a href="/stats/bac-ii.csv" download class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-3 py-2 text-sm font-medium hover:border-primary-400 hover:text-primary-700 dark:border-surface-700 dark:hover:text-primary-300"><i class="pi pi-download"></i>CSV</a>
          <a href="/stats/bac-ii.json" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-3 py-2 text-sm font-medium hover:border-primary-400 hover:text-primary-700 dark:border-surface-700 dark:hover:text-primary-300"><i class="pi pi-code"></i>JSON</a>
        </div>
      </div>
      <div class="max-h-[70vh] overflow-auto rounded-2xl border border-surface-200 dark:border-surface-800">
        <table class="w-full min-w-[60rem] text-left text-sm tabular-nums">
          <thead class="sticky top-0 z-10 bg-surface-50 text-xs text-surface-600 dark:bg-surface-900 dark:text-surface-400">
            <tr>
              <th class="sticky left-0 bg-surface-50 px-3 py-3 font-semibold dark:bg-surface-900">Year</th>
              <th class="px-3 py-3 font-semibold">Exam / results</th>
              <th class="px-3 py-3 text-right font-semibold">Registered</th>
              <th class="px-3 py-3 text-right font-semibold">Sat</th>
              <th class="px-3 py-3 text-right font-semibold">Passed</th>
              <th class="px-3 py-3 text-right font-semibold">Pass rate</th>
              {GRADE_KEYS.map((k) => <th class="px-3 py-3 text-right font-semibold">{k}</th>)}
              <th class="px-3 py-3 font-semibold">Notes</th>
              <th class="px-3 py-3 font-semibold">Sources</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-100 dark:divide-surface-800">
            {
              [...years].reverse().map((y) => (
                <tr id={`y${y.year}`} class="align-top hover:bg-primary-50/40 dark:hover:bg-primary-950/30">
                  <th scope="row" class="sticky left-0 bg-surface-0 px-3 py-2.5 font-semibold dark:bg-surface-950">
                    {y.year}
                    <span class="block text-[11px] font-normal text-surface-400">{y.academicYear}</span>
                  </th>
                  <td class="px-3 py-2.5 text-xs whitespace-nowrap text-surface-600 dark:text-surface-400">
                    {y.examDate && <span class="block">Exam: {y.examDate}</span>}
                    {y.resultsDate && <span class="block">Results: {y.resultsDate}</span>}
                  </td>
                  <td class="px-3 py-2.5 text-right">{n(y.registered)}</td>
                  <td class="px-3 py-2.5 text-right">{n(y.sat)}</td>
                  <td class="px-3 py-2.5 text-right">{y.cancelled ? 'all' : `${y.approx?.includes('passed') ? '≈ ' : ''}${n(y.passed)}`}</td>
                  <td class="px-3 py-2.5 text-right font-semibold">{y.cancelled ? <span class="font-normal text-surface-500">no exam</span> : pct(y.passRate)}</td>
                  {GRADE_KEYS.map((k) => <td class="px-3 py-2.5 text-right">{y.grades ? n(y.grades[k]) : '—'}</td>)}
                  <td class="max-w-72 px-3 py-2.5 text-xs text-surface-600 dark:text-surface-400">{y.note}</td>
                  <td class="px-3 py-2.5 text-xs whitespace-nowrap">
                    {y.sources.map((s) => (
                      <a href={`#src-${s}`} class="mr-1 text-primary-700 hover:underline dark:text-primary-300" title={SOURCES[s].title}>[{sourceNo(s)}]</a>
                    ))}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- Method + sources -->
    <section class="mt-14 grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <h2 class="text-xl font-bold">How this data is kept</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-surface-700 dark:text-surface-300">
          <li>Only figures released by the Ministry of Education, Youth and Sport: its own documents, or news reports quoting a ministry statement.</li>
          <li>Nothing is estimated. If a figure was never published, it shows as “—”.</li>
          <li>Pass rates are the ministry’s own figures, even where they differ slightly from passed ÷ candidates. These cases are explained in the notes.</li>
          <li>Where sources disagree, we use the figure whose grade counts add up to the published total, and note the other one.</li>
          <li>Year = the year the academic year ends (2025–2026 → 2026), as MoEYS does.</li>
        </ul>
        <p class="mt-4 text-sm text-surface-500">Updated {updated}. Found an official figure we’re missing? <a href="/about/" class="text-primary-700 hover:underline dark:text-primary-300">Tell us</a>.</p>
        <p class="mt-4 text-sm"><a href="/blog/bac-ii-results-2016-2026/" class="text-primary-700 hover:underline dark:text-primary-300">Read: Bac II results 2016–2026, a decade of official figures →</a></p>
      </div>
      <div>
        <h2 class="text-xl font-bold">Sources</h2>
        <ol class="mt-4 space-y-3 text-sm">
          {
            sourceIds.map((id, i) => {
              const s = SOURCES[id] as (typeof SOURCES)[keyof typeof SOURCES] & { url?: string; archive?: string };
              return (
                <li id={`src-${id}`} class="flex gap-3 scroll-mt-24">
                  <span class="w-7 shrink-0 text-right font-semibold text-surface-400">[{i + 1}]</span>
                  <span>
                    {s.url ? (
                      <a href={s.url} class="font-medium text-primary-700 hover:underline dark:text-primary-300" rel={s.url.startsWith('http') ? 'noopener' : undefined}>{s.title}</a>
                    ) : (
                      <span class="font-medium">{s.title}</span>
                    )}
                    <span class="block text-surface-500">
                      {s.publisher} · {s.date}
                      {s.archive && <> · <a href={s.archive} class="text-primary-700 hover:underline dark:text-primary-300">archived copy</a></>}
                    </span>
                    <span class="block text-xs text-surface-400">
                      Used for: {usedFor(id)}
                    </span>
                  </span>
                </li>
              );
            })
          }
        </ol>
      </div>
    </section>
  </div>
</BaseLayout>
