---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { SECTIONS, SECTION_ORDER, getArticles, getBooks } from '../lib/site';

const all = await getArticles();
const books = await getBooks();
const story = [
  { href: '/blog/welcome-to-seuksa/', label: 'Welcome to Seuksa.com (2012)' },
  { href: '/blog/my-missions-with-seuksa-com/', label: 'My missions with Seuksa.com' },
  { href: '/blog/why-is-seuksa-so-important-to-me/', label: 'ហេតុអ្វីបានជា សិក្សា សំខាន់សំរាប់ខ្ញុំ?' },
  { href: '/blog/seuksa-app-on-google-playstore/', label: 'Seuksa app on Google Play' },
  { href: '/blog/khmer-library-mobile-app/', label: 'Khmer Library mobile app' },
];
---

<BaseLayout title="About · អំពីយើង" description="About Seuksa (សិក្សា) and its sister book library Nitean (និទាន).">
  <PageHero title="About Seuksa" kicker="អំពីយើង" icon="pi pi-info-circle" description="An education social blog for Khmer society, started in 2012." />

  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-12 lg:grid-cols-[2fr_1fr]">
    <div class="prose max-w-none dark:prose-invert prose-a:text-primary-700 dark:prose-a:text-primary-300">
      <p lang="km">
        <strong>សិក្សា (Seuksa)</strong> ជាវេបសាយអប់រំសង្គម ដែលប្រមូលផ្តុំព័ត៌មានអប់រំ លទ្ធផលប្រឡងបាក់ឌុប ចំណេះដឹងខ្មែរ
        រឿងនិទាន និងសម្រង់ពាក្យមានប្រយោជន៍ សម្រាប់សិស្ស និស្សិត និងអ្នកស្រឡាញ់ការសិក្សាទាំងអស់។
      </p>
      <p>
        Seuksa began in 2012 as a network of small sites – a blog, a Q&amp;A site, Khmer stories and a quote site. This
        website brings the content that still matters back together in one place, with each part kept distinct:
      </p>
      <ul>
        {SECTION_ORDER.map((s) => (
          <li>
            <a href={`/${s}/`}>{SECTIONS[s].title}</a> <span lang="km">({SECTIONS[s].km})</span> – {SECTIONS[s].description}
          </li>
        ))}
      </ul>
      <h2>Nitean – the book library</h2>
      <p>
        <a href="/nitean/">Nitean (និទាន, “tale”)</a> is Seuksa’s sister project: an e-book library where long-form
        content lives as books with parts and chapters, such as the complete <em>Khmer Folktales</em> collection.
        Short articles stay on Seuksa; anything meant to be read as a book belongs to Nitean.
      </p>
      <h2>Contribute</h2>
      <p lang="km">សូមគាំទ្រយើង និងសូមផ្ញើអត្ថបទ រឿង ឬសម្រង់ពាក្យ មកកាន់យើងខ្ញុំ។ សូមអរគុណ៕</p>
      <p>
        The Khmer translations of quotes are made by volunteers and are not professionally reviewed. Folktale texts come from
        the open-source KhmerText project.
      </p>
    </div>

    <aside class="space-y-6">
      <div class="rounded-2xl border border-surface-200 p-6 dark:border-surface-800">
        <h2 class="font-semibold">By the numbers</h2>
        <dl class="mt-4 grid grid-cols-2 gap-4">
          {SECTION_ORDER.map((s) => (
            <div>
              <dt class="text-xs text-surface-500">{SECTIONS[s].title}</dt>
              <dd class="text-2xl font-bold text-primary-700 dark:text-primary-300">{all.filter((a) => a.data.section === s).length}</dd>
            </div>
          ))}
          <div>
            <dt class="text-xs text-surface-500">Nitean books</dt>
            <dd class="text-2xl font-bold text-primary-700 dark:text-primary-300">{books.length}</dd>
          </div>
        </dl>
      </div>
      <div class="rounded-2xl border border-surface-200 p-6 dark:border-surface-800">
        <h2 class="font-semibold">Our story</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {story.map((s) => <li><a class="text-primary-700 hover:underline dark:text-primary-300" href={s.href}>{s.label}</a></li>)}
        </ul>
        <h2 class="mt-6 font-semibold">Useful pages</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="text-primary-700 hover:underline dark:text-primary-300" href="/phnom-penh-postal-codes/">Phnom Penh postal codes</a></li>
          <li><a class="text-primary-700 hover:underline dark:text-primary-300" href="/app-privacy/">Seuksa app privacy policy</a></li>
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>
