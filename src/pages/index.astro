---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCover from '../components/BookCover.astro';
import QuoteSpotlight from '../components/QuoteSpotlight.vue';
import { SECTIONS, SECTION_ORDER, SITE, articleUrl, formatDate, getArticles, getBooks, htmlLang, toQuote } from '../lib/site';

const all = await getArticles();
const counts = Object.fromEntries(SECTION_ORDER.map((s) => [s, all.filter((a) => a.data.section === s).length]));
const latest = all.filter((a) => a.data.section === 'blog').slice(0, 6);
const knowledge = all.filter((a) => a.data.section === 'answers').slice(0, 5);
const stories = all.filter((a) => a.data.section === 'stories').slice(0, 5);
const quotes = all
  .filter((a) => a.data.section === 'quotes')
  .sort((a, b) => (b.data.views ?? 0) - (a.data.views ?? 0))
  .slice(0, 30)
  .map(toQuote);
const books = await getBooks();
const totalChapters = books.reduce((n, b) => n + b.data.chapters, 0);
---

<BaseLayout brand="seuksa">
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-surface-200 dark:border-surface-800">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_left,var(--p-primary-100),transparent_60%)] dark:bg-[radial-gradient(ellipse_at_top_left,var(--p-primary-950),transparent_60%)]"></div>
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 lg:grid-cols-[1.2fr_1fr] lg:py-24">
      <div>
        <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-primary-100 px-3 py-1 text-sm font-medium text-primary-800 dark:bg-primary-900 dark:text-primary-200">
          <i class="pi pi-graduation-cap"></i> Social education since 2012
        </p>
        <h1 class="text-4xl font-bold tracking-tight text-surface-900 sm:text-5xl dark:text-surface-0" lang="km">
          {SITE.seuksa.tagline}
        </h1>
        <p class="mt-5 max-w-xl text-lg text-surface-600 dark:text-surface-400">
          Seuksa (សិក្សា, “to study”) collects education news, Bac II results, Khmer knowledge, stories and quotes
          — written for Cambodian students and everyone who loves learning.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/blog/" class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-5 py-3 font-medium text-white shadow-sm hover:bg-primary-700">
            Read the blog <i class="pi pi-arrow-right text-sm"></i>
          </a>
          <a href="/nitean/" class="inline-flex items-center gap-2 rounded-lg border border-surface-300 px-5 py-3 font-medium hover:border-primary-400 hover:text-primary-700 dark:border-surface-700 dark:hover:text-primary-300">
            <i class="pi pi-book"></i> Open the Nitean library
          </a>
        </div>
      </div>
      <div class="rounded-3xl bg-gradient-to-br from-primary-700 to-primary-950 p-8 shadow-2xl shadow-primary-900/20">
        <p class="mb-4 text-xs font-semibold tracking-widest text-primary-200 uppercase">Quote of the moment</p>
        <QuoteSpotlight client:visible quotes={quotes} />
      </div>
    </div>
  </section>

  <!-- Sections -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="sr-only">Sections</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        SECTION_ORDER.map((s) => (
          <a href={`/${s}/`} class="group rounded-2xl border border-surface-200 p-6 transition hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-lg dark:border-surface-800">
            <span class="inline-flex size-11 items-center justify-center rounded-xl bg-primary-100 text-primary-700 dark:bg-primary-900 dark:text-primary-200">
              <i class={`${SECTIONS[s].icon} text-lg`} />
            </span>
            <h3 class="mt-4 flex items-baseline justify-between text-lg font-semibold text-surface-900 dark:text-surface-0">
              {SECTIONS[s].title}
              <span class="text-sm font-normal text-surface-400">{counts[s]}</span>
            </h3>
            <p class="text-sm text-primary-700 dark:text-primary-300" lang="km">{SECTIONS[s].km}</p>
            <p class="mt-2 text-sm text-surface-600 dark:text-surface-400">{SECTIONS[s].description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ReanKhmer bridge (rean.seuksa.com) -->
  <section class="mx-auto mb-16 max-w-6xl px-4" aria-labelledby="reankhmer-title">
    <div class="grid items-center gap-10 overflow-hidden rounded-3xl bg-gradient-to-br from-teal-700 to-teal-950 p-8 text-teal-50 sm:p-12 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="text-sm font-semibold tracking-widest text-teal-200 uppercase">New · Learn Khmer</p>
        <h2 id="reankhmer-title" class="mt-3 text-3xl font-bold">
          <span lang="km">រៀនខ្មែរ</span> · ReanKhmer
        </h2>
        <p class="mt-4 text-teal-100" lang="km">
          រៀនអាន ស្តាប់ និងនិយាយភាសាខ្មែរ ជាមួយសំឡេងពិត — សម្រាប់ក្រុមគ្រួសារខ្មែរនៅក្រៅប្រទេស។ ប្រើបានទោះគ្មានអ៊ីនធឺណិត។
        </p>
        <p class="mt-2 text-sm text-teal-200">
          Letters, vowels, spelling, reading, conversation and NiDA keyboard typing — 21 lessons and ~300 native-speaker
          recordings, first made in 2006 and rebuilt as an offline app.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="https://rean.seuksa.com/" class="inline-flex items-center gap-2 rounded-lg bg-white px-5 py-3 font-medium text-teal-900 hover:bg-teal-50">
            <i class="pi pi-play"></i> <span lang="km">ចាប់ផ្តើមរៀន</span> Start learning
          </a>
          <a href="/blog/reankhmer-story/" class="inline-flex items-center gap-2 rounded-lg border border-teal-300/60 px-5 py-3 font-medium hover:bg-white/10">
            Read the story <i class="pi pi-arrow-right text-sm"></i>
          </a>
        </div>
      </div>
      <a href="https://rean.seuksa.com/letters" class="grid grid-cols-3 gap-3 justify-self-center lg:justify-self-end" aria-label="ReanKhmer consonants" lang="km">
        {
          [['ក', 'Gor', 1], ['ខ', 'Khor', 1], ['គ', 'Kou', 2], ['ឃ', 'Khou', 2], ['ង', 'Ngou', 2], ['ច', 'Chor', 1]].map(([c, r, s]) => (
            <span class:list={['flex size-20 flex-col items-center justify-center rounded-2xl border-2 sm:size-24', s === 1 ? 'border-teal-300 bg-teal-50 text-teal-900' : 'border-amber-300 bg-amber-50 text-amber-900']}>
              <span class="font-khmer-serif text-4xl leading-none sm:text-5xl">{c}</span>
              <span class="mt-1 text-xs opacity-70" lang="en">{r}</span>
            </span>
          ))
        }
      </a>
    </div>
  </section>

  <!-- Latest blog -->
  <section class="mx-auto max-w-6xl px-4">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="text-2xl font-bold text-surface-900 dark:text-surface-0">Latest from the blog</h2>
      <a href="/blog/" class="text-sm font-medium text-primary-700 hover:underline dark:text-primary-300">All posts →</a>
    </div>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        latest.map((a) => (
          <a href={articleUrl(a)} class="group flex flex-col overflow-hidden rounded-2xl border border-surface-200 transition hover:border-primary-300 hover:shadow-lg dark:border-surface-800">
            {a.data.cover && <img src={a.data.cover} alt="" loading="lazy" class="aspect-[16/9] w-full object-cover" />}
            <div class="flex flex-1 flex-col gap-2 p-5">
              <time class="text-xs text-surface-500">{formatDate(a.data.date)}</time>
              <h3 class="font-semibold text-surface-900 group-hover:text-primary-700 dark:text-surface-0 dark:group-hover:text-primary-300" lang={htmlLang(a.data.lang)}>
                {a.data.title}
              </h3>
              <p class="line-clamp-3 text-sm text-surface-600 dark:text-surface-400" lang={htmlLang(a.data.lang)}>{a.data.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Knowledge + stories -->
  <section class="mx-auto mt-16 grid max-w-6xl gap-8 px-4 lg:grid-cols-2">
    {
      [
        { key: 'answers' as const, items: knowledge },
        { key: 'stories' as const, items: stories },
      ].map(({ key, items }) => (
        <div class="rounded-2xl border border-surface-200 p-6 dark:border-surface-800">
          <div class="mb-4 flex items-center justify-between">
            <h2 class="flex items-center gap-2 text-xl font-bold text-surface-900 dark:text-surface-0">
              <i class={`${SECTIONS[key].icon} text-primary-600`} />
              {SECTIONS[key].title}
              <span class="text-base font-normal text-surface-400" lang="km">· {SECTIONS[key].km}</span>
            </h2>
            <a href={`/${key}/`} class="text-sm text-primary-700 hover:underline dark:text-primary-300">More →</a>
          </div>
          <ul class="divide-y divide-surface-100 dark:divide-surface-800" lang="km">
            {items.map((a) => (
              <li>
                <a href={articleUrl(a)} class="block py-3 hover:text-primary-700 dark:hover:text-primary-300">
                  <span class="line-clamp-1 font-medium">{a.data.title}</span>
                  <span class="line-clamp-1 text-sm text-surface-500">{a.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <!-- Nitean bridge -->
  <section class="mx-auto mt-16 max-w-6xl px-4" data-brand="nitean">
    <div class="grid items-center gap-10 overflow-hidden rounded-3xl bg-stone-900 p-8 text-stone-100 sm:p-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold tracking-widest text-amber-400 uppercase">Our sister library</p>
        <h2 class="mt-3 font-khmer-serif text-3xl font-bold" lang="km">និទាន · Nitean</h2>
        <p class="mt-4 text-stone-300">
          Read {books.length} books and {totalChapters} chapters of Khmer folktales, legends and article collections
          in a calm, book-style reader.
        </p>
        <a href="/nitean/" class="mt-6 inline-flex items-center gap-2 rounded-lg bg-amber-500 px-5 py-3 font-medium text-stone-950 hover:bg-amber-400">
          Browse the library <i class="pi pi-arrow-right text-sm"></i>
        </a>
      </div>
      <div class="flex justify-center gap-4 lg:justify-end">
        {
          books.slice(0, 3).map((b, i) => (
            <a href={`/nitean/${b.id}/`} class:list={['w-28 transition hover:-translate-y-1 sm:w-36', i === 1 && 'mt-6']}>
              <BookCover book={b} />
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
