---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BookCover from '../../../components/BookCover.astro';
import { chapterUrl, getBooks, getChapters } from '../../../lib/site';

export async function getStaticPaths() {
  return (await getBooks()).map((book) => ({ params: { book: book.id }, props: { book } }));
}

const { book } = Astro.props as { book: CollectionEntry<'books'> };
const { Content: Copyright } = await render(book);
const chapters = await getChapters(book.id);
const { title, subtitle, description, parts, lang, author } = book.data;
const bookLang = lang === 'en' ? 'en' : 'km';

const groups = [
  { key: 'front', title: '', intro: undefined, items: chapters.filter((c) => c.data.kind === 'front') },
  ...parts.map((p) => ({ ...p, items: chapters.filter((c) => c.data.part === p.key) })),
  { key: 'back', title: 'Back matter', intro: undefined, items: chapters.filter((c) => c.data.kind === 'back') },
].filter((g) => g.items.length);
const first = chapters.find((c) => c.data.kind === 'chapter') ?? chapters[0];
---

<BaseLayout brand="nitean" title={subtitle ? `${title} – ${subtitle}` : title} description={description} image={book.data.cover} type="book" lang={bookLang}>
  <section class="border-b border-surface-200 bg-gradient-to-b from-primary-50/80 to-surface-0 dark:border-surface-800 dark:from-primary-950/40 dark:to-surface-950">
    <div class="mx-auto max-w-5xl px-4 pt-8 pb-14">
      <Breadcrumbs items={[{ label: 'Nitean', href: '/nitean/' }, { label: title }]} />
      <div class="mt-10 grid items-start gap-10 md:grid-cols-[220px_1fr]">
        <BookCover book={book} class="mx-auto w-48 md:w-full" />
        <div>
          <h1 class="font-khmer-serif text-4xl leading-tight font-bold text-surface-900 dark:text-surface-0">{title}</h1>
          {subtitle && <p class="mt-2 font-serif text-xl text-surface-500 italic" lang="en">{subtitle}</p>}
          <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-surface-500">
            <span><i class="pi pi-book mr-1.5"></i>{book.data.chapters} chapters</span>
            {parts.length > 1 && <span><i class="pi pi-folder mr-1.5"></i>{parts.length} parts</span>}
            {author && <span><i class="pi pi-user mr-1.5"></i>{author}</span>}
          </p>
          {description && <p class="mt-6 font-khmer-serif text-lg leading-loose text-surface-700 dark:text-surface-300">{description}</p>}
          {
            first && (
              <a href={chapterUrl(first)} class="mt-8 inline-flex items-center gap-2 rounded-lg bg-primary-700 px-6 py-3 font-medium text-white shadow-sm hover:bg-primary-800">
                <i class="pi pi-book" /> Start reading
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-12" aria-labelledby="toc">
    <h2 id="toc" class="mb-6 font-serif text-2xl font-semibold">Contents <span class="font-khmer-serif text-lg font-normal text-surface-400" lang="km">· មាតិកា</span></h2>
    <div class="space-y-4">
      {
        groups.map((g, gi) => (
          <details open={gi < 2 || groups.length <= 3} class="group rounded-2xl border border-surface-200 bg-surface-0 open:shadow-sm dark:border-surface-800 dark:bg-surface-900">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 [&::-webkit-details-marker]:hidden">
              <span class="font-khmer-serif text-lg font-semibold">{g.title || 'Introduction'}</span>
              <span class="flex items-center gap-3 text-sm text-surface-400">
                {g.items.length}
                <i class="pi pi-chevron-down text-xs transition group-open:rotate-180" />
              </span>
            </summary>
            {g.intro && <p class="-mt-1 px-6 pb-3 font-khmer-serif text-sm text-surface-500">{g.intro}</p>}
            <ol class="grid border-t border-surface-100 px-3 py-3 sm:grid-cols-2 dark:border-surface-800">
              {g.items.map((c, i) => (
                <li>
                  <a href={chapterUrl(c)} class="flex gap-3 rounded-lg px-3 py-2 hover:bg-primary-50 hover:text-primary-800 dark:hover:bg-primary-950 dark:hover:text-primary-200">
                    <span class="w-6 shrink-0 text-right text-sm text-surface-400 tabular-nums">{c.data.kind === 'chapter' ? i + 1 : '·'}</span>
                    <span class="font-khmer-serif">{c.data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </details>
        ))
      }
    </div>

    {
      book.body?.trim() && (
        <div class="prose prose-sm prose-stone mt-12 max-w-none rounded-2xl bg-surface-50 p-6 dark:bg-surface-900 dark:prose-invert">
          <h2 class="!mt-0 text-base">Copyright</h2>
          <Copyright />
        </div>
      )
    }
  </section>
</BaseLayout>
