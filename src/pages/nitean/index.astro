---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCover from '../../components/BookCover.astro';
import { SITE, getBooks, getChapters, chapterUrl } from '../../lib/site';

const books = await getBooks();
const featured = books[0];
const featuredChapters = (await getChapters(featured.id)).filter((c) => c.data.kind === 'chapter');
// Deterministic "pick" so builds are reproducible.
const picks = [0, 0.25, 0.5, 0.75].map((f) => featuredChapters[Math.floor(f * featuredChapters.length)]);
const totalChapters = books.reduce((n, b) => n + b.data.chapters, 0);
---

<BaseLayout brand="nitean" title="Library · បណ្ណាល័យ" description={SITE.nitean.taglineEn}>
  <section class="border-b border-surface-200 bg-gradient-to-b from-primary-50 via-surface-50 to-surface-0 dark:border-surface-800 dark:from-primary-950/50 dark:via-surface-950 dark:to-surface-950">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:py-20">
      <p class="text-sm font-semibold tracking-[0.3em] text-primary-700 uppercase dark:text-primary-400">Nitean Library</p>
      <h1 class="mt-4 font-khmer-serif text-4xl font-bold text-surface-900 sm:text-5xl dark:text-surface-0" lang="km">
        អានច្រើន ចម្រើនចំណេះ
      </h1>
      <p class="mx-auto mt-4 max-w-2xl font-serif text-lg text-surface-600 italic dark:text-surface-400">
        “Read more, know more.” Khmer folktales, legends and collections – {books.length} books, {totalChapters} chapters.
      </p>
    </div>
  </section>

  <!-- Shelf -->
  <section class="mx-auto max-w-6xl px-4 py-14" aria-labelledby="shelf">
    <h2 id="shelf" class="mb-8 font-serif text-2xl font-semibold">On the shelf</h2>
    <ul class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-5">
      {
        books.map((b) => (
          <li>
            <a href={`/nitean/${b.id}/`} class="group block">
              <BookCover book={b} class="transition duration-300 group-hover:-translate-y-1.5 group-hover:shadow-2xl" />
              <h3 class="mt-4 font-khmer-serif font-semibold text-surface-900 group-hover:text-primary-700 dark:text-surface-0 dark:group-hover:text-primary-300" lang={b.data.lang === 'en' ? 'en' : 'km'}>
                {b.data.title}
              </h3>
              {b.data.subtitle && <p class="text-sm text-surface-500">{b.data.subtitle}</p>}
              <p class="mt-1 text-xs text-surface-400">{b.data.chapters} {b.data.chapters === 1 ? 'chapter' : 'chapters'}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-6 h-3 rounded-full bg-gradient-to-b from-surface-300 to-surface-200 shadow-inner dark:from-surface-700 dark:to-surface-800" aria-hidden="true"></div>
  </section>

  <!-- Featured -->
  <section class="mx-auto max-w-6xl px-4">
    <div class="grid gap-10 rounded-3xl border border-surface-200 bg-surface-50 p-8 sm:p-10 lg:grid-cols-[220px_1fr] dark:border-surface-800 dark:bg-surface-900">
      <a href={`/nitean/${featured.id}/`} class="mx-auto w-44 lg:w-full"><BookCover book={featured} /></a>
      <div>
        <p class="text-sm font-semibold tracking-widest text-primary-700 uppercase dark:text-primary-400">Featured collection</p>
        <h2 class="mt-2 font-khmer-serif text-3xl font-bold" lang="km">{featured.data.title}</h2>
        <p class="mt-1 text-surface-500">{featured.data.subtitle} · {featured.data.parts.length} volumes</p>
        <p class="mt-4 font-khmer-serif leading-loose text-surface-700 dark:text-surface-300" lang="km">{featured.data.description}</p>
        <h3 class="mt-8 text-sm font-semibold text-surface-500">Start reading</h3>
        <ul class="mt-3 grid gap-3 sm:grid-cols-2" lang="km">
          {
            picks.map((c) => (
              <li>
                <a href={chapterUrl(c)} class="block rounded-xl border border-surface-200 bg-surface-0 p-4 hover:border-primary-300 hover:shadow-md dark:border-surface-700 dark:bg-surface-950">
                  <span class="font-khmer-serif font-semibold">{c.data.title}</span>
                  <span class="mt-1 line-clamp-2 block text-sm text-surface-500">{c.data.description}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
