---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { PROSE, formatDate, htmlLang } from '../lib/site';

export async function getStaticPaths() {
  return (await getCollection('pages')).map((entry) => ({ params: { page: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'pages'> };
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} lang={htmlLang(entry.data.lang)}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <Breadcrumbs items={[{ label: 'Seuksa', href: '/' }, { label: entry.data.title }]} />
    <h1 class="mt-8 text-3xl font-bold tracking-tight sm:text-4xl">{entry.data.title}</h1>
    {entry.data.updated && <p class="mt-2 text-sm text-surface-500">Updated {formatDate(entry.data.updated)}</p>}
    <div class:list={[PROSE, 'mt-8 overflow-x-auto']}><Content /></div>
  </article>
</BaseLayout>
