---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ArticleExplorer from '../../components/ArticleExplorer.vue';
import QuoteWall from '../../components/QuoteWall.vue';
import { SECTIONS, SECTION_ORDER, getArticles, toCard, toQuote, type Section } from '../../lib/site';

export function getStaticPaths() {
  return SECTION_ORDER.map((section) => ({ params: { section } }));
}

const section = Astro.params.section as Section;
const meta = SECTIONS[section];
const items = await getArticles(section);
---

<BaseLayout title={`${meta.title} · ${meta.km}`} description={meta.description}>
  <PageHero title={meta.title} kicker={meta.km} icon={meta.icon} description={meta.description}>
    <p class="mt-3 text-sm text-surface-500">{items.length} {section === 'quotes' ? 'quotes' : 'articles'}</p>
  </PageHero>
  <div class="mx-auto max-w-6xl px-4 py-10">
    {
      section === 'quotes' ? (
        <QuoteWall client:load items={items.map(toQuote)} />
      ) : (
        <ArticleExplorer client:load items={items.map(toCard)} />
      )
    }
  </div>
</BaseLayout>
