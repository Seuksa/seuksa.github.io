---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QuoteEmbedBuilder from '../../components/QuoteEmbedBuilder.vue';
import { SITE } from '../../lib/site';
import { EMBED_LICENSE, getEmbedQuotes } from '../../lib/quotes';

const quotes = await getEmbedQuotes();
const categories = [...new Set(quotes.flatMap((q) => q.categories))].sort();
const options = [
  ['data-quote', '"daily" (default) · "random" · a quote id', 'Which quote to show. The id is the last part of a quote’s URL.'],
  ['data-category', 'e.g. "Inspiration"', 'Limit daily / random quotes to one theme.'],
  ['data-lang', '"both" (default) · "en" · "km"', 'English, Khmer, or both lines.'],
  ['data-theme', '"light" (default) · "dark" · "auto"', '"auto" follows the visitor’s system setting.'],
  ['data-accent', 'e.g. "#0891b2"', 'Accent colour for the quote mark and link.'],
  ['data-shuffle', '"true"', 'Adds an “another quote” button (daily / random).'],
];
---

<BaseLayout
  title="Embed our quotes · បង្កប់សម្រង់ពាក្យ"
  description="Show Seuksa quotes in English and Khmer on your own website – free, with a link back to seuksa.com."
>
  <PageHero
    title="Put a quote on your website"
    kicker="បង្កប់សម្រង់ពាក្យ · Embed"
    icon="pi pi-code"
    description={`Show one of our ${quotes.length} English & Khmer quotes on any website or blog. Free to use – just keep the small “Seuksa Quotes” link.`}
  >
    <div class="mt-6"><Breadcrumbs items={[{ label: 'Quotes', href: '/quotes/' }, { label: 'Embed' }]} /></div>
  </PageHero>

  <div class="mx-auto max-w-6xl px-4 py-12">
    <!-- Loaded before the island hydrates, so the builder preview uses the real embed script. -->
    <script is:inline src="/embed/quote.js"></script>
    <QuoteEmbedBuilder client:load quotes={quotes.map((q) => ({ id: q.id, title: q.title }))} categories={categories} origin={SITE.url} />

    <section class="mt-20 grid gap-10 lg:grid-cols-[2fr_1fr]">
      <div>
        <h2 class="text-2xl font-bold">Options</h2>
        <p class="mt-2 text-surface-600 dark:text-surface-400">
          Set these attributes on the <code class="rounded bg-surface-100 px-1.5 py-0.5 text-sm dark:bg-surface-800">.seuksa-quote</code> element.
          For the iframe, use the same names as query parameters without <code class="text-sm">data-</code>.
        </p>
        <div class="mt-6 overflow-x-auto rounded-2xl border border-surface-200 dark:border-surface-800">
          <table class="w-full text-left text-sm">
            <thead class="bg-surface-50 text-surface-600 dark:bg-surface-900 dark:text-surface-400">
              <tr><th class="px-4 py-3 font-semibold">Attribute</th><th class="px-4 py-3 font-semibold">Values</th><th class="px-4 py-3 font-semibold">What it does</th></tr>
            </thead>
            <tbody class="divide-y divide-surface-200 dark:divide-surface-800">
              {options.map(([name, values, what]) => (
                <tr>
                  <td class="px-4 py-3 font-mono text-xs whitespace-nowrap text-primary-700 dark:text-primary-300">{name}</td>
                  <td class="px-4 py-3 font-mono text-xs">{values}</td>
                  <td class="px-4 py-3 text-surface-600 dark:text-surface-400">{what}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class="mt-12 text-2xl font-bold">For developers</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-surface-700 dark:text-surface-300">
          <li>
            Several widgets on one page share a single request. Content added later (single-page apps) can be rendered with
            <code class="text-sm">SeuksaQuote.render(element)</code> or <code class="text-sm">SeuksaQuote.renderAll()</code>.
          </li>
          <li>
            The widget renders inside a Shadow DOM, so your site’s CSS won’t break it. Style the card from outside with
            <code class="text-sm">.seuksa-quote::part(card)</code>.
          </li>
          <li>
            JSON API: <a class="text-primary-700 hover:underline dark:text-primary-300" href="/api/quotes.json">/api/quotes.json</a>
            (all quotes) and <code class="text-sm">/api/quotes/&lt;id&gt;.json</code> (one quote). CORS is open.
          </li>
          <li>No cookies, no tracking scripts. The link back carries <code class="text-sm">utm_source</code> with your site’s hostname.</li>
        </ul>
      </div>

      <aside class="h-fit rounded-2xl border border-primary-200 bg-primary-50 p-6 dark:border-primary-900 dark:bg-primary-950/50">
        <h2 class="flex items-center gap-2 font-semibold text-primary-900 dark:text-primary-100"><i class="pi pi-heart"></i> Terms of use</h2>
        <p class="mt-3 text-sm text-primary-900/80 dark:text-primary-100/80">{EMBED_LICENSE}</p>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-primary-900/80 dark:text-primary-100/80">
          <li>Please don’t hide or remove the “Seuksa Quotes” link.</li>
          <li>Quotes keep their original authors; Khmer translations are by Seuksa volunteers.</li>
          <li>Copying quotes into your own pages? Credit and link to the quote’s page on seuksa.com.</li>
        </ul>
        <p class="mt-4 text-sm" lang="km">សូមរក្សាតំណភ្ជាប់មកកាន់ សិក្សា។ សូមអរគុណ!</p>
      </aside>
    </section>
  </div>
</BaseLayout>
