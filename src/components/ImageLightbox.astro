---
/**
 * Click-to-enlarge image viewer for content images.
 * Any <img> with or inside an element with [data-lightbox] opens in a dialog, with previous/next across that page's images,
 * the figure caption (or alt text), keyboard (← → Esc) and swipe support. Include once per page.
 */
---

<dialog
  id="lightbox"
  class="m-0 h-dvh max-h-none w-screen max-w-none bg-transparent p-0 text-white backdrop:bg-black/95 backdrop:backdrop-blur-sm open:flex"
  aria-label="Image viewer"
>
  <div class="relative flex h-full w-full flex-col">
    <div class="flex items-center justify-between gap-3 px-4 py-3 text-sm">
      <span data-lb-count class="tabular-nums text-white/70"></span>
      <div class="flex items-center gap-1">
        <a data-lb-open target="_blank" rel="noopener" class="rounded-full p-2.5 text-white/80 hover:bg-white/10 hover:text-white" title="Open the original image">
          <i class="pi pi-external-link" aria-hidden="true"></i><span class="sr-only">Open the original image</span>
        </a>
        <button type="button" data-lb-close class="rounded-full p-2.5 text-white/80 hover:bg-white/10 hover:text-white" title="Close (Esc)">
          <i class="pi pi-times text-lg" aria-hidden="true"></i><span class="sr-only">Close</span>
        </button>
      </div>
    </div>

    <div data-lb-stage class="relative flex min-h-0 flex-1 items-center justify-center px-2 sm:px-16">
      <img data-lb-img alt="" class="max-h-full max-w-full select-none rounded-lg object-contain shadow-2xl" />
      <button
        type="button"
        data-lb-prev
        class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-black/40 p-3 text-white/80 hover:bg-white/15 hover:text-white sm:left-4"
        title="Previous (←)"
      >
        <i class="pi pi-chevron-left text-xl" aria-hidden="true"></i><span class="sr-only">Previous image</span>
      </button>
      <button
        type="button"
        data-lb-next
        class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-black/40 p-3 text-white/80 hover:bg-white/15 hover:text-white sm:right-4"
        title="Next (→)"
      >
        <i class="pi pi-chevron-right text-xl" aria-hidden="true"></i><span class="sr-only">Next image</span>
      </button>
    </div>

    <p data-lb-caption class="mx-auto max-h-[22vh] w-full max-w-3xl overflow-y-auto px-4 pt-3 pb-5 text-center text-sm leading-relaxed text-white/85 [&_*]:!text-white"></p>
  </div>
</dialog>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dlg) {
    const $ = <T extends Element>(s: string) => dlg.querySelector(s) as T;
    const img = $<HTMLImageElement>('[data-lb-img]');
    const caption = $<HTMLElement>('[data-lb-caption]');
    const count = $<HTMLElement>('[data-lb-count]');
    const open = $<HTMLAnchorElement>('[data-lb-open]');
    const prev = $<HTMLButtonElement>('[data-lb-prev]');
    const next = $<HTMLButtonElement>('[data-lb-next]');

    // Content images only: skip tiny icons/emoji and images inside links to other pages.
    const items = [...document.querySelectorAll<HTMLImageElement>('img[data-lightbox], [data-lightbox] img')].filter((el) => {
      if (el.closest('dialog')) return false;
      const a = el.closest('a');
      if (a && !/\.(jpe?g|png|gif|webp|avif|svg)(\?|#|$)/i.test(a.getAttribute('href') ?? '')) return false;
      const w = Number(el.getAttribute('width')) || el.naturalWidth || 999;
      return w >= 80;
    });
    let i = 0;

    const full = (el: HTMLImageElement) => {
      const href = el.closest('a')?.getAttribute('href');
      return href && /\.(jpe?g|png|gif|webp|avif|svg)(\?|#|$)/i.test(href) ? new URL(href, location.href).href : el.currentSrc || el.src;
    };
    const text = (el: HTMLImageElement) => {
      const fc = el.closest('figure')?.querySelector('figcaption');
      return fc?.innerHTML.trim() || (el.alt ? el.alt.replace(/[<>&]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' })[c]!) : '');
    };

    const show = (n: number) => {
      i = (n + items.length) % items.length;
      const el = items[i];
      img.src = full(el);
      img.alt = el.alt;
      caption.innerHTML = text(el);
      caption.hidden = !caption.innerHTML;
      count.textContent = items.length > 1 ? `${i + 1} / ${items.length}` : '';
      open.href = img.src;
      prev.hidden = next.hidden = items.length < 2;
      // Preload the neighbours for instant paging.
      if (items.length > 1) [i + 1, i - 1].forEach((k) => (new Image().src = full(items[(k + items.length) % items.length])));
    };

    items.forEach((el, n) => {
      el.classList.add('cursor-zoom-in');
      const target = el.closest('a') ?? el;
      target.addEventListener('click', (e) => {
        e.preventDefault();
        show(n);
        dlg.showModal();
        document.documentElement.style.overflow = 'hidden';
      });
    });

    const close = () => dlg.close();
    dlg.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      img.removeAttribute('src');
    });
    $('[data-lb-close]').addEventListener('click', close);
    prev.addEventListener('click', () => show(i - 1));
    next.addEventListener('click', () => show(i + 1));
    // Click on the dark area (not the image, buttons or caption) closes.
    dlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dlg || t.hasAttribute('data-lb-stage')) close();
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(i + 1);
      else if (e.key === 'ArrowLeft') show(i - 1);
    });
    let x0: number | null = null;
    dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    dlg.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50 && items.length > 1) show(dx < 0 ? i + 1 : i - 1);
      x0 = null;
    });
  }
</script>
