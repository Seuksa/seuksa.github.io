---
interface Props {
  title: string;
  kicker?: string;
  description?: string;
  icon?: string;
  lang?: string;
}
const { title, kicker, description, icon, lang } = Astro.props;
---

<section class="border-b border-surface-200 bg-gradient-to-b from-primary-50/70 to-transparent dark:border-surface-800 dark:from-primary-950/40">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    {
      kicker && (
        <p class="mb-3 inline-flex items-center gap-2 text-sm font-medium text-primary-700 dark:text-primary-300">
          {icon && <i class={icon} />}
          {kicker}
        </p>
      )
    }
    <h1 class="text-3xl font-bold tracking-tight text-surface-900 sm:text-4xl dark:text-surface-0" lang={lang}>{title}</h1>
    {description && <p class="mt-4 max-w-2xl text-lg text-surface-600 dark:text-surface-400">{description}</p>}
    <slot />
  </div>
</section>
